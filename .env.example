# ---- Development (pnpm dev) ----
# Where the API finds MongoDB. directConnection=true lets a single-node replica set work from your machine.
MONGO_URL=mongodb://localhost:27017/erp?replicaSet=rs0&directConnection=true
# "mongo" (default) or "memory" (no database needed; data is lost on restart)
STORE=mongo
API_PORT=3001

# ---- Production (docker compose up) ----
# Port the app is served on: http://localhost:8080
WEB_PORT=8080
# Port MongoDB is published on (127.0.0.1 only)
MONGO_PORT=27017
# Add starter rows to empty sheets when the API starts
SEED_ON_START=true
